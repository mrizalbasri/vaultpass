{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VaultPass",
  "version": "0.1.1",
  "identifier": "com.rizal.vaultpass",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VaultPass",
        "width": 1080,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "zoomHotkeysEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-pinch --overscroll-history-navigation=0"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "M. Rizal Basri",
    "homepage": "https://github.com/mrizalbasri/vaultpass",
    "copyright": "Copyright © 2026 M. Rizal Basri",
    "category": "Utility",
    "shortDescription": "Offline desktop password & API key manager",
    "longDescription": "Offline desktop password and API key manager built with Tauri and Rust, with Windows Hello and AI Agent CLI support.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyNEI5OThDMzcwRDM1QzEKUldUQk5RMDNqSmxMa3AzSngxT3FlMUp6L1dpUVZkTkI2S3VTV0Y2Z1lUYi8xU0FNY2xUTGhZRjkK",
      "endpoints": [
        "https://github.com/mrizalbasri/vaultpass/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
